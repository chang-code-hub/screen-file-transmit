<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<OutputType>WinExe</OutputType>
		<AssemblyName>screen-file-receiver</AssemblyName>
		<RootNamespace>screen_file_transmit</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWPF>true</UseWPF>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<Platforms>x64</Platforms>
		<RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<LangVersion>Latest</LangVersion> 
		<!-- 版本号（AssemblyVersion/AssemblyFileVersion/AssemblyInformationalVersion）由 npm/publish.js 发布时
		     写入 Properties/AssemblyInfo.cs；本项目 GenerateAssemblyInfo=false，SDK 不会自动生成版本属性。 -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="icon.ico" />
	</ItemGroup> 
	<ItemGroup>
		<Reference Include="System.Management" />
  		<EmbeddedResource Remove="**\opencv_videoio_ffmpeg*.dll" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CSharp" />
		<PackageReference Include="OpenCvSharp4" />
		<PackageReference Include="OpenCvSharp4.Extensions" />
		<PackageReference Include="Costura.Fody">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="PropertyChanged.Fody">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="ReedSolomon" />
		<PackageReference Include="System.Data.DataSetExtensions" />
		<PackageReference Include="System.Linq.Expressions" />
		<PackageReference Include="ZXing.Net" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<PackageReference Include="OpenCvSharp4.runtime.win" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<PackageReference Include="OpenCvSharp4.runtime.win.slim" />
	</ItemGroup>
	<ItemGroup>
		<Resource Include="icon.ico" />
	</ItemGroup>
	<PropertyGroup>
		<OutDir>bin\$(Configuration)</OutDir>
	</PropertyGroup>
</Project>