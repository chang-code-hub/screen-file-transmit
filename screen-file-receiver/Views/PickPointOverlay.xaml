<Window
    x:Class="screen_file_transmit.PickPointOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowsTransparency="True"
    Background="Transparent"
    Cursor="Cross"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <!-- 只在选区/目标窗口范围内覆盖一层蒙版，其余区域不遮挡 -->
    <Border
        x:Name="MaskBorder"
        Background="#40FFFFFF"
        BorderBrush="White"
        BorderThickness="1" />
</Window>
