<Window
    x:Class="about.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About"
    Width="420"
    MouseDown="AboutWindow_OnMouseDown"
    Height="360"
    AllowsTransparency="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.Resources>
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <Border
        Background="White"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        CornerRadius="8">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#333333"
                    Text="{Binding ProductName, FallbackValue='Application'}" />
                <Button
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Click="CloseButton_Click"
                    Content="X"
                    FontWeight="Bold"
                    Foreground="#888888"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" />
            </Grid>

            <!-- Separator -->
            <Separator Grid.Row="1" Margin="0,0,0,10" />

            <!-- Icon and Product Name -->
            <StackPanel Grid.Row="2">
                <Image
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Source="/icon.ico" />
                <TextBlock
                    Style="{StaticResource TitleStyle}"
                    Text="{Binding ProductName, FallbackValue='Product Name'}" />
                <TextBlock
                    Style="{StaticResource LabelStyle}"
                    Text="{Binding VersionDisplay, FallbackValue='Version 1.0.0'}" />
            </StackPanel>

            <!-- Description -->
            <TextBlock
                Grid.Row="3"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="#777777"
                Text="{Binding DescriptionText, FallbackValue=''}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <!-- Copyright -->
            <StackPanel Grid.Row="4" Margin="0,15,0,0">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="#999999"
                    Text="{Binding CopyrightText, FallbackValue='Copyright 2026'}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="#999999"
                    Text="All rights reserved." />
            </StackPanel>

            <!-- OK Button -->
            <Button
                Grid.Row="5"
                Width="80"
                Height="26"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                Click="OkButton_Click"
                Content="OK"
                IsDefault="True" />
        </Grid>
    </Border>
</Window>
