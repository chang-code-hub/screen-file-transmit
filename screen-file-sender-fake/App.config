<?xml version="1.0" encoding="utf-8"?> 
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
	</startup>
	<appSettings>
		<add key="CompanyName" value="Example Corp" />
		<add key="ProductName" value="Example Application" />
		<add key="Version" value="2.5.0" />
		<add key="Description" value="This application provides essential functionality for your daily workflow. For more information, please visit our website." />
	</appSettings>
</configuration>